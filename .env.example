# Shared configuration. .env is loaded by all three compose files via
# env_file: ../.env. On separate hosts: copy the needed lines to each host.
VOICEHUB_BIND=127.0.0.1
VOICEHUB_PORT=8790

# Base URL used by the vox and edge containers (host network => loopback).
# On another host: http://SERVER:8790 (or https via a reverse proxy).
VOICEHUB_URL=http://127.0.0.1:8790
VOICEHUB_TOKEN=CHANGE_ME

# Host directory holding the vox/whisper models (e.g. medium.pt).
# Used by vox/docker-compose.yml via ${VOICEHUB_MODELS_DIR} — pass this file
# with `--env-file` so compose can substitute it (see README).
VOICEHUB_MODELS_DIR=./models
